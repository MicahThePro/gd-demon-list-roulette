{
  "name": "demonroulette",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "worker:test": "node --experimental-sqlite worker/auth.test.js && node --experimental-sqlite worker/api.test.js && node --experimental-sqlite worker/submissions.test.js && node --experimental-sqlite worker/accounts.test.js && node src/services/sourceNames.test.js && node src/utils/codes.test.js",
    "test:render": "node scripts/render-test.mjs",
    "test": "npm run worker:test && npm run test:render",
    "db:migrate": "wrangler d1 migrations apply demon-roulette --remote",
    "update:challenge-list": "node scripts/build-challenge-list.mjs",
    "update:impossible-levels": "node scripts/build-impossible-levels.mjs",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "gh-pages": "^6.3.0",
    "globals": "^17.12.0",
    "vite": "^8.3.0",
    "wrangler": "^4.0.0"
  }
}
